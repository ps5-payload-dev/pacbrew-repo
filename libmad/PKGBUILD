pkgname=ps5-payload-libmad
pkgver=0.16.5
pkgrel=1
pkgdesc="A high-quality MPEG audio decoder"
arch=('any')
url="https://www.underbit.com/products/mad/"
license=('GPL')
source=("https://codeberg.org/tenacityteam/libmad/releases/download/${pkgver}/libmad-${pkgver}.tar.gz")
sha256sums=('f401b2ccf49c26ad0c3a6ef0179b1cbbff2406338b0603bb2033e6dcaf706114')
options=(!strip libtool staticlibs)
groups=('ps5-payload-dev')
makedepends=('ps5-payload-sdk' 'ps5-payload-libcxx')


prepare() {
    if [ -z "${PS5_PAYLOAD_SDK}" ]; then
	export PS5_PAYLOAD_SDK=/opt/ps5-payload-sdk
    fi
}

build() {
    source "${PS5_PAYLOAD_SDK}/toolchain/prospero.sh"
    cd mad-${pkgver}-source

    ${CMAKE} -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_SHARED_LIBS=OFF \
        -DEXAMPLE=OFF \
	    -B build \
        -S .
    ${MAKE} -C build
}

package() {
    source "${PS5_PAYLOAD_SDK}/toolchain/prospero.sh"
    cd mad-${pkgver}-source

    export DESTDIR="${pkgdir}/${DESTDIR}"
    ${MAKE} -C build install

    ${PS5_CROSS_FIX_ROOT} "${DESTDIR}/${PREFIX}"
}
