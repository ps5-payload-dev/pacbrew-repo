pkgname=ps5-payload-dht
pkgver=0.28
pkgrel=1
pkgdesc='BitTorrent DHT library'
arch=('any')
url='https://github.com/jech/dht'
license=('MIT')
options=(!strip libtool staticlibs)
source=(https://github.com/jech/dht/archive/refs/tags/dht-$pkgver.tar.gz
        dht-cmake-1.patch::https://github.com/transmission/dht/commit/015585510e402a057ec17142711ba2b568b5fd62.patch
        dht-cmake-2.patch::https://github.com/transmission/dht/commit/38c9f261d9b58b76b9eaf85f84ec1b35151a1eac.patch)
sha256sums=('2f91db29636ca84503b4bb59d7a4a6a681c3a547e12ef775f83e99b69be92f2d'
            'd0ae373f650a96b579a6a1aac824fbcb0041254d1bc1bdcc7e09cd854f1d5b38'
            'f767d6a1c01b426b1717686b9329e89df798ae93e13a84b81be224211e189d4f')

groups=('ps5-payload-dev')
makedepends=('ps5-payload-sdk')

prepare() {
    if [ -z "${PS5_PAYLOAD_SDK}" ]; then
	export PS5_PAYLOAD_SDK=/opt/ps5-payload-sdk
    fi
    # Add cmake support
    patch -d dht-dht-$pkgver -p1 < dht-cmake-1.patch
    patch -d dht-dht-$pkgver -p1 < dht-cmake-2.patch
}

build() {
    source "${PS5_PAYLOAD_SDK}/toolchain/prospero.sh"
    cd dht-dht-$pkgver

    ${CMAKE} -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_INCLUDEDIR=include/dht \
        -B build \
        -S .
    ${MAKE} -C build
}

package() {
    source "${PS5_PAYLOAD_SDK}/toolchain/prospero.sh"
    cd dht-dht-$pkgver

    export DESTDIR="${pkgdir}/${DESTDIR}"
    ${MAKE} -C build install

    ${PS5_CROSS_FIX_ROOT} "${DESTDIR}/${PREFIX}"
}
