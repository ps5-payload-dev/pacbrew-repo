groups=('ps5-payload-dev' 'ps5-payload-gl')
makedepends=('ps5-payload-sdk' 'ps5-payload-libcxx' 'ps5-payload-openlibm'
	     'ps5-payload-zlib' 'ps5-payload-zstd')

prepare() {
    if [ -z "${PS5_PAYLOAD_SDK}" ]; then
	export PS5_PAYLOAD_SDK=/opt/ps5-payload-sdk
    fi
    cd mesa-$pkgver

    local p
    for p in "${srcdir}"/[0-9][0-9][0-9][0-9]-*.patch; do
	echo "Applying $(basename "$p")"
	patch -Np1 -i "$p"
    done
}

build() {
    cd mesa-$pkgver

    # build host tools
    meson setup builddir-host \
	  -Dbuildtype=release \
	  -Dmesa-clc=enabled \
	  -Dinstall-mesa-clc=true \
	  -Dgallium-drivers= \
	  -Dvulkan-drivers= \
	  -Dplatforms= \
	  -Dglx=disabled \
	  -Degl=disabled \
	  -Dgbm=disabled \
	  -Dopengl=false \
	  -Dgles1=disabled \
	  -Dgles2=disabled \
	  -Dllvm=enabled \
	  -Dvalgrind=disabled \
	  -Dlibunwind=disabled \
	  -Dzstd=disabled \
	  -Dexpat=disabled \
	  -Dxmlconfig=disabled \
	  -Dbuild-tests=false

    meson compile -C builddir-host \
	  src/compiler/clc/mesa_clc \
	  src/compiler/spirv/vtn_bindgen2

    export PATH="$PWD/builddir-host/src/compiler/clc:$PATH"
    export PATH="$PWD/builddir-host/src/compiler/spirv:$PATH"
    
    # build target libs
    source "${PS5_PAYLOAD_SDK}/toolchain/prospero.sh"

    local build_id
    build_id=$(cat <(echo "${pkgver}") "${srcdir}"/[0-9][0-9][0-9][0-9]-*.patch \
		   | sha1sum | cut -d' ' -f1)

    ${MESON} setup builddir \
	     -Ddefault_library=shared \
	     -Dbuildtype=release \
	     -Db_ndebug=true \
	     -Dradv-build-id=${build_id} \
	     -Dradv-winsys=ps5 \
	     -Dvulkan-drivers=amd \
	     -Dvulkan-layers= \
	     -Dgallium-drivers=zink \
	     -Dplatforms=videoout \
	     -Degl=enabled \
	     -Dopengl=true \
	     -Dgles2=enabled \
	     -Dgles1=disabled \
	     -Dglx=disabled \
	     -Dgbm=disabled \
	     -Dmesa-clc=system \
	     -Dllvm=disabled \
	     -Dzstd=enabled \
	     -Dzlib=enabled \
	     -Dshader-cache=enabled \
	     -Dvalgrind=disabled \
	     -Dlibunwind=disabled \
	     -Dexpat=disabled \
	     -Dxmlconfig=disabled \
	     -Dvideo-codecs= \
	     -Dbuild-tests=false

    ${MESON} compile -C builddir
}

package() {
    source "${PS5_PAYLOAD_SDK}/toolchain/prospero.sh"
    cd mesa-$pkgver

    ${MESON} install -C builddir --destdir "${pkgdir}/${PS5_SYSROOT}"
}
