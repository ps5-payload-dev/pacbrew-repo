index 855fc6c1cc6..ff7a27db480 100644
--- a/meson.build
+++ b/meson.build
@@ -500,6 +500,9 @@ with_platform_wayland = _platforms.contains('wayland')
 with_platform_haiku = _platforms.contains('haiku')
 with_platform_windows = _platforms.contains('windows')
 with_platform_macos = _platforms.contains('macos')
+# EGL on a VK_KHR_display through zink (src/egl/drivers/dri2/platform_videoout.c):
+# the PlayStation 5's display, which has no window system.
+with_platform_videoout = _platforms.contains('videoout')
 
 # RADV on the PlayStation 5: no DRM device, no libdrm, a winsys of its own
 # (src/amd/vulkan/winsys/ps5). AMD_NO_DRM marks the code the Windows port
@@ -601,6 +604,10 @@ if with_gbm
   pre_args += '-DHAVE_LIBGBM'
 endif
 
+if with_platform_videoout and not (with_egl and with_gallium_zink)
+  error('The videoout platform is EGL on zink: it needs -Degl=enabled and zink in -Dgallium-drivers')
+endif
+
 if with_egl
   _platforms += 'surfaceless'
   if with_gbm and not with_platform_android
@@ -608,7 +615,7 @@ if with_egl
   endif
 
   # All the other platforms can be detected and cannot reach the native platform code
-  _undetectable_platforms = ['x11', 'haiku', 'android', 'surfaceless']
+  _undetectable_platforms = ['x11', 'haiku', 'android', 'surfaceless', 'videoout']
 
   # Don't enforce the native platform if none of the undetectable platforms are enabled
   _undetectable_platforms_enabled = []
