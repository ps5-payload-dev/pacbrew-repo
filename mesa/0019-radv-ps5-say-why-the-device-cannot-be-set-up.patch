From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: PS5 Mesa port <ps5-mesa@localhost>
Date: Wed, 7 Oct 2026 19:21:55 +0000
Subject: [PATCH] radv/ps5: say why the device cannot be set up

Without a submission ring or a completion marker there is no device, and
nothing said why. Report the failing call (direct memory allocation or
mapping, or a mapping outside the 32-bit window or the GPU's range) on
stderr.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_014ZqjJDSiP9GQFUidfnxiHF
---
 src/amd/vulkan/winsys/ps5/radv_ps5_platform.c | 26 +++++++++++++++++--
 src/amd/vulkan/winsys/ps5/radv_ps5_platform.h |  6 +++--
 src/amd/vulkan/winsys/ps5/radv_ps5_winsys.c   |  9 +++++--
 3 files changed, 35 insertions(+), 6 deletions(-)

diff --git a/src/amd/vulkan/winsys/ps5/radv_ps5_platform.c b/src/amd/vulkan/winsys/ps5/radv_ps5_platform.c
index f9bcc4b45e8..46ffd1052dc 100644
--- a/src/amd/vulkan/winsys/ps5/radv_ps5_platform.c
+++ b/src/amd/vulkan/winsys/ps5/radv_ps5_platform.c
@@ -202,6 +202,17 @@ radv_ps5_window_contains(uint64_t address, uint64_t bytes)
           address - RADV_PS5_WINDOW_BASE <= RADV_PS5_WINDOW_BYTES - bytes;
 }
 
+static thread_local char radv_ps5_memory_error_text[160];
+
+const char *
+radv_ps5_memory_error(void)
+{
+   return radv_ps5_memory_error_text;
+}
+
+#define radv_ps5_memory_fail(...)                                                                  \
+   snprintf(radv_ps5_memory_error_text, sizeof(radv_ps5_memory_error_text), __VA_ARGS__)
+
 #if defined(__PROSPERO__)
 
 /* ------------------------------------------------------------------ console */
@@ -302,9 +313,14 @@ radv_ps5_memory_alloc(uint64_t bytes, uint64_t alignment, bool window32, struct
    alignment = util_next_power_of_two64(alignment);
 
    int64_t physical = -1;
-   if (sceKernelAllocateDirectMemory(0, sceKernelGetDirectMemorySize(), bytes, alignment,
-                                     RADV_PS5_DIRECT_TYPE, &physical) != 0)
+   const int32_t allocated = sceKernelAllocateDirectMemory(0, sceKernelGetDirectMemorySize(), bytes, alignment,
+                                                           RADV_PS5_DIRECT_TYPE, &physical);
+   if (allocated != 0) {
+      radv_ps5_memory_fail("sceKernelAllocateDirectMemory(%" PRIu64 " bytes) failed: 0x%08x (pool %" PRId64
+                           " bytes)",
+                           bytes, (unsigned)allocated, (int64_t)sceKernelGetDirectMemorySize());
       return false;
+   }
 
    /* A window buffer goes where the kernel puts a mapping it is given no
     * address for, which is the window (PS5_Vulkan R86); anything else goes in
@@ -339,6 +355,12 @@ radv_ps5_memory_alloc(uint64_t bytes, uint64_t alignment, bool window32, struct
                        (window32 ? radv_ps5_window_contains(va, bytes)
                                  : va < RADV_PS5_GPU_ADDRESS_LIMIT && bytes <= RADV_PS5_GPU_ADDRESS_LIMIT - va);
    if (!placed) {
+      if (result != 0)
+         radv_ps5_memory_fail("sceKernelMapDirectMemory(%" PRIu64 " bytes) failed: 0x%08x", bytes,
+                              (unsigned)result);
+      else
+         radv_ps5_memory_fail("the kernel mapped %" PRIu64 " bytes at 0x%" PRIx64 ", outside the %s", bytes, va,
+                              window32 ? "32-bit window" : "GPU's address range");
       if (result == 0 && address != NULL)
          sceKernelMunmap(address, bytes);
       radv_ps5_granules_give(&radv_ps5_region, granule, granules);
diff --git a/src/amd/vulkan/winsys/ps5/radv_ps5_platform.h b/src/amd/vulkan/winsys/ps5/radv_ps5_platform.h
index ddaa94a495a..74cdc09afcb 100644
--- a/src/amd/vulkan/winsys/ps5/radv_ps5_platform.h
+++ b/src/amd/vulkan/winsys/ps5/radv_ps5_platform.h
@@ -50,10 +50,12 @@ struct radv_ps5_memory {
    bool window_replay;
 };
 
-/* Initialises AGC once per process. It has to run from the title's own
- * executable, which the driver archive is linked into. */
+/* Initialises AGC once per process (sceAgcInit). */
 bool radv_ps5_platform_init(void);
 
+/* Why this thread's last radv_ps5_memory_alloc failed, or "" (console only). */
+const char *radv_ps5_memory_error(void);
+
 /* Whether a replayable window buffer can be placed at its captured address
  * again, whatever else the process mapped since (radv_ps5_memory_alloc_replayable). */
 bool radv_ps5_window_replayable(void);
diff --git a/src/amd/vulkan/winsys/ps5/radv_ps5_winsys.c b/src/amd/vulkan/winsys/ps5/radv_ps5_winsys.c
index e31c3d64206..fd657f297a3 100644
--- a/src/amd/vulkan/winsys/ps5/radv_ps5_winsys.c
+++ b/src/amd/vulkan/winsys/ps5/radv_ps5_winsys.c
@@ -41,13 +41,18 @@ static void
 radv_ps5_queue_create(void)
 {
    struct radv_ps5_queue *const queue = &radv_ps5_queue_storage;
-   if (!radv_ps5_platform_init())
+   if (!radv_ps5_platform_init()) {
+      fprintf(stderr, "radv/ps5: the platform did not initialise; no device\n");
       return;
+   }
    /* The words the GPU runs and the marker it writes live in the window, where
     * ps5vk's submission buffer has always been. */
-   if (!radv_ps5_memory_alloc(RADV_PS5_RING_BYTES, RADV_PS5_LARGE_BYTES, true, &queue->ring))
+   if (!radv_ps5_memory_alloc(RADV_PS5_RING_BYTES, RADV_PS5_LARGE_BYTES, true, &queue->ring)) {
+      fprintf(stderr, "radv/ps5: no submission ring: %s; no device\n", radv_ps5_memory_error());
       return;
+   }
    if (!radv_ps5_memory_alloc(RADV_PS5_PAGE_BYTES, RADV_PS5_PAGE_BYTES, true, &queue->marker_memory)) {
+      fprintf(stderr, "radv/ps5: no completion marker: %s; no device\n", radv_ps5_memory_error());
       radv_ps5_memory_free(&queue->ring);
       return;
    }
