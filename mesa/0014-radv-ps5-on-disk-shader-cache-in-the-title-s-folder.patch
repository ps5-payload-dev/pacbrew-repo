@@ -712,7 +816,13 @@ destroy_mtx:
    simple_mtx_destroy(&db->flock_mtx);
 
    ralloc_free(db->mem_ctx);
-close_index:
+close_locks:
+   for (unsigned i = 0; i < 2; i++) {
+      if (db->lock_fds[i] >= 0)
+         close(db->lock_fds[i]);
+      db->lock_fds[i] = -1;
+   }
+   db->owned = false;
    mesa_db_free_file(&db->index);
 close_cache:
    mesa_db_free_file(&db->cache);
@@ -720,6 +830,18 @@ close_cache:
    return false;
 }
 
+bool
