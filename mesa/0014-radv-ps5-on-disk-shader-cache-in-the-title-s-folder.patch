+      if (db->lock_fds[0] < 0 || db->lock_fds[1] < 0 ||
+          flock(db->lock_fds[0], LOCK_EX | LOCK_NB) < 0 ||
+          flock(db->lock_fds[1], LOCK_EX | LOCK_NB) < 0)
+         goto close_locks;
