 src/amd/common/ac_gpu_info.h                  | 27 ++++++++-
 src/amd/common/nir/ac_nir.h                   |  2 +
 .../nir/ac_nir_lower_intrinsics_to_args.c     |  4 +-
 src/amd/compiler/aco_ir.cpp                   |  2 +
