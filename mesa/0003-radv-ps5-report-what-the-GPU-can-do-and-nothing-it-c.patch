                                  info->family == CHIP_KRACKAN1 || info->gfx_level == GFX11_7;
+   out->has_flat_scratch = info->gfx_level >= GFX9;
+   out->has_cs_wave_id = info->gfx_level >= GFX10_3;
+   out->has_ngg_per_prim_params = info->gfx_level >= GFX10_3;
