 src/amd/vulkan/radv_device.c                  |  2 +-
 src/amd/vulkan/radv_physical_device.c         | 52 ++++++++++-------
 src/amd/vulkan/radv_physical_device.h         |  2 +
 src/amd/vulkan/radv_pipeline.c                | 25 +++++---
 src/amd/vulkan/radv_shader_info.c             |  7 ++-
 src/amd/vulkan/winsys/ps5/radv_ps5_winsys.c   | 57 ++++++++++++++++++-
 16 files changed, 174 insertions(+), 54 deletions(-)

