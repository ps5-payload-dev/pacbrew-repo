+    * PS5, whose GPU addresses are its CPU addresses) in the bottom one. */
+   return compiler_info->ac->gfx_level >= GFX9 ? nir_ishr_imm(b, nir_ishl_imm(b, addr, 16), 16) : addr;
 }
 
