diff --git a/src/amd/vulkan/nir/radv_nir_rt_common.c b/src/amd/vulkan/nir/radv_nir_rt_common.c
index 555c8a25613..079f4b4e225 100644
--- a/src/amd/vulkan/nir/radv_nir_rt_common.c
+++ b/src/amd/vulkan/nir/radv_nir_rt_common.c
@@ -410,9 +410,11 @@ build_node_to_addr(const struct radv_compiler_info *compiler_info, nir_builder *
 {
    nir_def *addr = skip_type_and ? node : nir_iand_imm(b, node, ~7ull);
