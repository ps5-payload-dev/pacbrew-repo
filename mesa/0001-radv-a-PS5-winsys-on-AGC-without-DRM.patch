+    * registers its suspended part wrote. */
+   if ((pRenderingInfo->flags & VK_RENDERING_RESUMING_BIT) && !device->ws->cs_split)
       return;
 
-   radeon_check_space(device->ws, cs->b, 10);
+   radv_emit_rendering_area(cmd_buffer);
 
