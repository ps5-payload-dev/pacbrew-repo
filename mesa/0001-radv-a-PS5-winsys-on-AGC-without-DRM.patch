+    * has its own way back: a bound pipeline is emitted again, bound shader
+    * objects are bound again at the next draw. */
+   if (state->graphics_pipeline)
+      dirty &= ~RADV_CMD_DIRTY_GRAPHICS_SHADERS;
+   else
